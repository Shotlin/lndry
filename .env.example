# Supabase server configuration (keep service-role credentials server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical LNDRY partner-lead handoff. The API URL includes /api/v1 and must
# use HTTPS in production. Configure the same secret on Lndry_backend as
# WEBSITE_PARTNER_LEAD_HMAC_SECRET. Do not use NEXT_PUBLIC_ for either value.
LNDRY_PARTNER_LEAD_API_URL=https://api.lndry.in/api/v1
LNDRY_PARTNER_LEAD_HMAC_SECRET=
